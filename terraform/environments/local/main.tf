# Calls the reusable module to provision the dev environment
module "dev_platform" {
  # Relative path to the module directory on disk.
  source      = "../../modules/k8s_platform"
  # Passes "dev" to the module's environment input variable
  environment = "dev"
}

# Calls the reusable module to provision the prod environment
module "prod_platform" {
  # Relative path to the module directory on disk.
  source      = "../../modules/k8s_platform"
  # Passes "prod" to the module's environment input variable
  environment = "prod"
}

# Automatically exports local .env for Docker Compose parity without manual copy-pasting
# Declares a resource that writes a rendered text file to the local host filesystem
resource "local_file" "compose_env" {
  # Calculates the relative path to place .env in the repository root
  filename        = "${path.module}/../../../.env"
  # Restricts file permissions so only your Linux user can read/write this credential file
  file_permission = "0600"
  /*
    Heredoc opening syntax: begins a multi-line formatted template string
    - Sets the image tag/version for Docker Compose
    - Sets the host port mapping for order-service
    - Sets the database name for Docker Compose
    - Sets the PostgreSQL admin user name for Docker Compose
    - Sets the PostgreSQL admin user password for Docker Compose (for env "dev")
    - Constructs Spring Boot's JDBC connection string using Docker Compose DNS
    - Sets Spring Boot's datasource username
    - Sets Spring Boot's datasource password to match the PostgreSQL password
  */
  content         = <<-EOT
# Auto-generated by Terraform local environment
IMAGE_TAG=${var.image_tag}
ORDER_SERVICE_PORT=${var.order_service_port}

POSTGRES_DB=order_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${module.dev_platform.database_password}

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/order_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=${module.dev_platform.database_password}
EOT
}