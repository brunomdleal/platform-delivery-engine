# Declares the output "namespace"
output "namespace" {
  description = "Provisioned namespace name"
  # Returns the actual name of the created Kubernetes namespace
  value       = kubernetes_namespace.env.metadata[0].name
}

# Declares the output "secret_name"
output "secret_name" {
  description = "Name of the database credentials secret"
  # Returns the actual name of the created Kubernetes secret resource
  value       = kubernetes_secret.postgres_credentials.metadata[0].name
}

# Declares the output "database_password"
output "database_password" {
  description = "Generated database password"
  # Returns the password generated by the random_password resource
  value       = random_password.db_password.result
  # Masks this value in CLI logs and console output to prevent credential leaking
  sensitive   = true
}